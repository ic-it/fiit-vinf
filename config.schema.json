{
  "$defs": {
    "Compression": {
      "enum": [
        "none",
        "gzip",
        "xz"
      ],
      "title": "Compression",
      "type": "string"
    },
    "FailureAction": {
      "enum": [
        "defer",
        "pause"
      ],
      "title": "FailureAction",
      "type": "string"
    },
    "FailurePolicy": {
      "additionalProperties": false,
      "properties": {
        "rate_limit": {
          "$ref": "#/$defs/FailureAction",
          "default": "defer"
        },
        "temporary": {
          "$ref": "#/$defs/FailureAction",
          "default": "defer"
        },
        "other": {
          "$ref": "#/$defs/FailureAction",
          "default": "defer"
        },
        "max_attempts": {
          "default": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_delay_seconds": {
          "default": 60,
          "minimum": 0,
          "title": "Retry Delay Seconds",
          "type": "number"
        },
        "max_retry_delay_seconds": {
          "default": 3600,
          "minimum": 0,
          "title": "Max Retry Delay Seconds",
          "type": "number"
        }
      },
      "title": "FailurePolicy",
      "type": "object"
    },
    "HttpConfig": {
      "additionalProperties": false,
      "properties": {
        "user_agent": {
          "default": "FIITVinfCrawler/0.10 (educational project; +https://vi2026.ui.sav.sk/doku.php)",
          "title": "User Agent",
          "type": "string"
        },
        "delay_seconds": {
          "default": 10,
          "minimum": 0,
          "title": "Delay Seconds",
          "type": "number"
        },
        "rate_limit_scope": {
          "$ref": "#/$defs/RateLimitScope",
          "default": "site"
        },
        "connect_timeout": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Connect Timeout",
          "type": "number"
        },
        "read_timeout": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Read Timeout",
          "type": "number"
        },
        "max_response_bytes": {
          "default": 10485760,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "max_redirects": {
          "default": 5,
          "maximum": 20,
          "minimum": 0,
          "title": "Max Redirects",
          "type": "integer"
        }
      },
      "title": "HttpConfig",
      "type": "object"
    },
    "ParallelConfig": {
      "additionalProperties": false,
      "properties": {
        "workers": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Workers",
          "type": "integer"
        }
      },
      "title": "ParallelConfig",
      "type": "object"
    },
    "ProxyConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "url_env": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Url Env",
          "type": "string"
        },
        "delay_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay Seconds"
        },
        "robots_strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/RobotsStrategy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failures": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailurePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "url_env"
      ],
      "title": "ProxyConfig",
      "type": "object"
    },
    "ProxyPoolConfig": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "size": {
          "default": 16,
          "maximum": 32,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "fallback_direct": {
          "default": true,
          "title": "Fallback Direct",
          "type": "boolean"
        },
        "connect_timeout": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Connect Timeout",
          "type": "number"
        },
        "read_timeout": {
          "default": 15,
          "exclusiveMinimum": 0,
          "title": "Read Timeout",
          "type": "number"
        }
      },
      "required": [
        "file"
      ],
      "title": "ProxyPoolConfig",
      "type": "object"
    },
    "RateLimitScope": {
      "enum": [
        "site",
        "proxy"
      ],
      "title": "RateLimitScope",
      "type": "string"
    },
    "RobotsConfig": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "$ref": "#/$defs/RobotsStrategy",
          "default": "respect"
        }
      },
      "title": "RobotsConfig",
      "type": "object"
    },
    "RobotsStrategy": {
      "enum": [
        "respect",
        "strict",
        "config-first",
        "ignore"
      ],
      "title": "RobotsStrategy",
      "type": "string"
    },
    "ScopeConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "include_subdomains": {
          "default": false,
          "title": "Include Subdomains",
          "type": "boolean"
        },
        "allowed_schemes": {
          "default": [
            "http",
            "https"
          ],
          "items": {
            "type": "string"
          },
          "title": "Allowed Schemes",
          "type": "array"
        },
        "allow_url_patterns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allow Url Patterns",
          "type": "array"
        },
        "deny_url_patterns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Deny Url Patterns",
          "type": "array"
        }
      },
      "title": "ScopeConfig",
      "type": "object"
    },
    "StorageConfig": {
      "additionalProperties": false,
      "properties": {
        "compression": {
          "$ref": "#/$defs/Compression",
          "default": "none"
        },
        "membership_cache_mib": {
          "default": 32,
          "maximum": 1024,
          "minimum": 0,
          "title": "Membership Cache Mib",
          "type": "integer"
        },
        "catalog_interval_pages": {
          "default": 1000,
          "minimum": 0,
          "title": "Catalog Interval Pages",
          "type": "integer"
        }
      },
      "title": "StorageConfig",
      "type": "object"
    },
    "TraversalConfig": {
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth"
        },
        "max_pages": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pages"
        },
        "max_total_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Bytes"
        },
        "max_links_per_page": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Links Per Page"
        },
        "prefer_url_patterns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prefer Url Patterns",
          "type": "array"
        }
      },
      "title": "TraversalConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 2,
      "maximum": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "seeds": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/ScopeConfig"
    },
    "traversal": {
      "$ref": "#/$defs/TraversalConfig"
    },
    "http": {
      "$ref": "#/$defs/HttpConfig"
    },
    "robots": {
      "$ref": "#/$defs/RobotsConfig"
    },
    "failures": {
      "$ref": "#/$defs/FailurePolicy"
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig"
    },
    "proxies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProxyConfig"
      },
      "title": "Proxies",
      "type": "array"
    },
    "proxy_pool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProxyPoolConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parallel": {
      "$ref": "#/$defs/ParallelConfig"
    }
  },
  "required": [
    "seeds"
  ],
  "title": "CrawlConfig",
  "type": "object"
}
